{
  "name": "nest-fintech-kafka",
  "version": "0.1.0",
  "description": "Fintech microservices monorepo (NestJS 11 + Prisma + Kafka). Apps: accounts-service, transactions-service.",
  "author": "Bohdan Tsekhmeistruk",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "build:accounts": "nest build accounts",
    "build:transactions": "nest build transactions",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:accounts": "nest start accounts",
    "start:transactions": "nest start transactions",
    "start:accounts:dev": "nest start accounts --watch",
    "start:transactions:dev": "nest start transactions --watch",
    "start:accounts:prod": "node dist/apps/accounts/main",
    "start:transactions:prod": "node dist/apps/transactions/main",
    "prisma:generate": "npm run prisma:generate:accounts && npm run prisma:generate:transactions",
    "prisma:generate:accounts": "prisma generate --schema apps/accounts/prisma/schema.prisma",
    "prisma:generate:transactions": "prisma generate --schema apps/transactions/prisma/schema.prisma",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:accounts": "jest --config ./apps/accounts/test/jest-e2e.json",
    "test:transactions": "jest --config ./apps/transactions/test/jest-e2e.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.0.11",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}
